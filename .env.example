
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
JWT_SIGNING_KEY=change-me-jwt-signing-key

POSTGRES_DB=forum
POSTGRES_USER=forum
POSTGRES_PASSWORD=forum_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Root credentials are only for MinIO administration/bootstrap.
MINIO_ROOT_USER=forum_local_root
MINIO_ROOT_PASSWORD=forum_local_root_secret_change_this_2026
# Application credentials are separate and bucket-scoped by minio-init.
S3_ACCESS_KEY=forum_local_access
S3_SECRET_KEY=forum_local_secret_change_this_2026
S3_BUCKET=forum-media
S3_REGION=us-east-1
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGNED_EXPIRES=900
S3_MAX_FILE_SIZE=30000000000
S3_MULTIPART_PART_SIZE=67108864
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
S3_CONFIGURE_BUCKET_CORS=0
MEDIA_REQUIRE_SCAN=0

REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_DOCS_ENABLED=1
READINESS_CHECK_S3=1
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_UPLOADS=120/min

LOG_LEVEL=INFO
LOG_FORMAT=console
SLOW_QUERY_MS=250
METRICS_ENABLED=1
METRICS_TOKEN=
CELERY_HEARTBEAT_STALE_SECONDS=90
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=night-iris@0.8.11
SENTRY_TRACES_SAMPLE_RATE=0.0
