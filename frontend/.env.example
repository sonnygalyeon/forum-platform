
# Host-only Next.js development. Docker Compose overrides this with api:8000.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
BACKEND_FETCH_TIMEOUT_MS=10000
# Recommended for macOS/Docker Desktop host -> container development to avoid
# stale Undici keep-alive sockets. Docker-to-Docker development uses 0.
BACKEND_DISABLE_KEEPALIVE=1
