{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip

    log {
        output stdout
        format json
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }

    @websocket path /ws/*
    reverse_proxy @websocket api:8000

    @django path /api/v1/* /api/schema/* /api/docs/* /api/redoc/* /static/*
    reverse_proxy @django api:8000

    reverse_proxy frontend:3000
}

{$MEDIA_DOMAIN} {
    encode zstd gzip

    log {
        output stdout
        format json
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
    }

    reverse_proxy minio:9000
}
