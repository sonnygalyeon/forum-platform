
__pycache__/
*.py[cod]
.venv/
.DS_Store
.vscode/
.idea/
staticfiles/
media/
*.log

# Secrets / local environment. Commit examples only.
.env
.env.*
!.env.example
!.env.prod.example
!frontend/.env.example

# Database / user-data dumps must never be committed.
*.sql
*.dump
*.dump.gz
*.sqlite3

# Test / coverage artifacts.
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# Frontend build/runtime artifacts.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/npm-debug.log*
frontend/tsconfig.tsbuildinfo

# Backups and local deployment state remain local.
backups/postgres/*.dump
backups/postgres/*.sha256
backups/minio/*
backups/manifests/*
!backups/minio/.gitkeep
.deploy/
