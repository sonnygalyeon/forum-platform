# ---------- Public domains ----------
APP_DOMAIN=forum.example.com
MEDIA_DOMAIN=media.forum.example.com
ACME_EMAIL=admin@example.com

# ---------- Release provenance ----------
APP_VERSION=1.0.0
# BUILD_SHA is injected by scripts/deploy_prod.sh from the checked-out commit.
SENTRY_RELEASE=night-iris@1.0.0

# ---------- Django ----------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-another-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=forum.example.com,api
CSRF_TRUSTED_ORIGINS=https://forum.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
POSTGRES_CONN_MAX_AGE=60

API_DOCS_ENABLED=0
READINESS_CHECK_S3=1

# ---------- PostgreSQL ----------
POSTGRES_DB=forum
POSTGRES_USER=forum
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis / Celery ----------
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/2

# ---------- MinIO / S3 ----------
# Root/admin credentials are NOT used by Django.
MINIO_ROOT_USER=replace-with-a-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-a-minio-root-password
# Django receives a separate bucket-scoped account created by minio-init.
S3_ACCESS_KEY=replace-with-a-long-access-key
S3_SECRET_KEY=replace-with-a-long-secret-key
S3_BUCKET=forum-media
S3_REGION=us-east-1
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.forum.example.com
S3_PRESIGNED_EXPIRES=900
S3_MAX_FILE_SIZE=30000000000
S3_MULTIPART_PART_SIZE=67108864
S3_CORS_ALLOWED_ORIGINS=https://forum.example.com
S3_CONFIGURE_BUCKET_CORS=0

# ---------- Media quarantine / malware scanning ----------
# Set MEDIA_REQUIRE_SCAN=1 only when the worker can reach the configured
# ClamAV-compatible daemon. Its StreamMaxLength/MaxFileSize limits must be
# configured for the largest files you intend to accept. Assets rejected by
# the scanner remain unavailable and are removed from object storage.
MEDIA_REQUIRE_SCAN=0
MEDIA_SCANNER_BACKEND=clamav
MEDIA_SCANNER_HOST=scanner.internal.example
MEDIA_SCANNER_PORT=3310
MEDIA_SCANNER_TIMEOUT_SECONDS=120

# ---------- Browser / API ----------
CORS_ALLOWED_ORIGINS=https://forum.example.com
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_UPLOADS=120/min

# ---------- Next.js BFF ----------
BACKEND_API_URL=http://api:8000/api/v1
BACKEND_FETCH_TIMEOUT_MS=10000
BACKEND_DISABLE_KEEPALIVE=0

# ---------- Backups ----------
BACKUP_RETENTION_DAYS=14

# ---------- Observability ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
SLOW_QUERY_MS=250
METRICS_ENABLED=1
METRICS_TOKEN=replace-with-a-long-metrics-token
CELERY_HEARTBEAT_STALE_SECONDS=90
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
