# ---------- Public domains ----------
APP_DOMAIN=forum.example.com
MEDIA_DOMAIN=media.forum.example.com
ACME_EMAIL=admin@example.com

# ---------- Django ----------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-another-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=forum.example.com
CSRF_TRUSTED_ORIGINS=https://forum.example.com
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
# External HTTP→HTTPS redirect is handled by Caddy. Keep Django redirect off
# because the Next.js BFF talks to Django over the private HTTP network.
POSTGRES_CONN_MAX_AGE=60

# Disable public API docs unless you intentionally want them exposed.
API_DOCS_ENABLED=0
READINESS_CHECK_S3=1

# ---------- PostgreSQL ----------
POSTGRES_DB=forum
POSTGRES_USER=forum
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis / Celery ----------
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# ---------- MinIO / S3 ----------
S3_ACCESS_KEY=replace-with-a-long-access-key
S3_SECRET_KEY=replace-with-a-long-secret-key
S3_BUCKET=forum-media
S3_REGION=us-east-1
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.forum.example.com
S3_PRESIGNED_EXPIRES=900
S3_MAX_FILE_SIZE=30000000000
S3_MULTIPART_PART_SIZE=67108864
S3_CORS_ALLOWED_ORIGINS=https://forum.example.com
S3_CONFIGURE_BUCKET_CORS=0
MEDIA_REQUIRE_SCAN=0

# ---------- Browser / API ----------
CORS_ALLOWED_ORIGINS=https://forum.example.com
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_UPLOADS=120/min

# ---------- Next.js BFF ----------
BACKEND_API_URL=http://api:8000/api/v1

# ---------- Backups ----------
BACKUP_RETENTION_DAYS=14
